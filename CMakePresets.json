{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${workspaceFolder}/out/"
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-debug",
      "displayName": "Build Debug",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-release",
      "displayName": "Build Release",
      "configuration": "Release"
    }
  ]
}